    <widget class="QLabel" name="formatHintLabel">
     <property name="text">
      <string>Format: "Label|Width|Height" or "WidthxHeight". Examples: 1280×720 or Coding|1280|720. Invalid entries are ignored. Commas and "|" are reserved, removed from labels, and commas separate entries.</string>
     </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
