<ui version="4.0">
 <class>SizerMenuConfigForm</class>
 <widget class="QWidget" name="SizerMenuConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>420</width>
    <height>320</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>KSizer</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="instructionsLabel">
     <property name="text">
      <string>Create and manage resize presets for the KSizer menu.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="presetsGroup">
     <property name="title">
      <string>Presets</string>
     </property>
     <layout class="QVBoxLayout" name="presetsLayout">
      <item>
       <widget class="KEditListWidget" name="kcfg_Presets"/>
      </item>
      <item>
    <widget class="QLabel" name="formatHintLabel">
     <property name="text">
      <string>Format: "Label|Width|Height" or "WidthxHeight". Examples: 1280×720 or Coding|1280|720. Invalid entries are ignored. Commas and "|" are reserved, removed from labels, and commas separate entries.</string>
     </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="behaviorGroup">
     <property name="title">
      <string>Behavior</string>
     </property>
     <layout class="QVBoxLayout" name="behaviorLayout">
      <item>
       <widget class="QCheckBox" name="kcfg_CenterWindow">
        <property name="text">
         <string>Center windows when applying presets</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="centerHintLabel">
        <property name="text">
         <string>When disabled, windows keep their current position and only resize. Cascade and Grid arrangements always center.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="indent">
         <number>18</number>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="kcfg_ClampToArea">
        <property name="text">
         <string>Clamp oversized presets to screen</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="clampHintLabel">
        <property name="text">
         <string>When disabled, windows may be partially off-screen if the preset exceeds the available area.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="indent">
         <number>18</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="allWindowsGroup">
     <property name="title">
      <string>All windows of an app</string>
     </property>
     <layout class="QVBoxLayout" name="allWindowsLayout">
      <item>
       <layout class="QHBoxLayout" name="arrangementLayout">
        <item>
         <widget class="QLabel" name="arrangementLabel">
          <property name="text">
           <string>Arrangement:</string>
          </property>
          <property name="buddy">
           <cstring>kcfg_AllWindowsArrangement</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="kcfg_AllWindowsArrangement">
          <item>
           <property name="text">
            <string>Cascade</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Grid</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Stack</string>
           </property>
          </item>
         </widget>
        </item>
        <item>
         <spacer name="arrangementSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="spacingLayout">
        <item>
         <widget class="QLabel" name="spacingLabel">
          <property name="text">
           <string>Grid spacing:</string>
          </property>
          <property name="buddy">
           <cstring>kcfg_GridSpacing</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="kcfg_GridSpacing">
          <property name="suffix">
           <string> px</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>200</number>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="spacingSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="arrangementHintLabel">
        <property name="text">
         <string>Applies to the app's windows on the current desktop, arranged per screen.

Cascade - Offsets each window slightly. Always centered.
Grid - Places windows side by side, separated by the grid spacing. Always centered. Falls back to Cascade when they do not fit.
Stack - Places each window as if resized alone. Follows the centering setting.

Minimized windows stay minimized and take no slot. They, and a screen with only one of the app's windows, follow the centering setting.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="reloadHintLabel">
     <property name="text">
      <string>Note: If changes do not appear immediately, disable and re-enable the script in KWin Scripts.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="linksLabel">
     <property name="text">
      <string>&lt;a href="https://github.com/allenguarnes/KSizer"&gt;GitHub&lt;/a&gt; · &lt;a href="https://buymeacoffee.com/allenguarnes"&gt;Buy Me a Coffee&lt;/a&gt; ☕</string>
     </property>
     <property name="openExternalLinks">
      <bool>true</bool>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
